{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "洛神赋",
  "version": "1.0.2",
  "identifier": "com.lochacha.luoshenfu",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://localhost:1421",
    "frontendDist": "../dist/web"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [{
      "label": "main",
      "title": "洛神赋",
      "width": 1480,
      "height": 920,
      "minWidth": 1120,
      "minHeight": 720,
      "center": true
    }],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:*; img-src 'self' data: blob: http://127.0.0.1:*; media-src 'self' blob: http://127.0.0.1:*; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Productivity",
    "shortDescription": "Codex 与 Deepseek 本地双智能体任务面板",
    "externalBin": ["binaries/node"],
    "resources": { "resources/": "" },
    "icon": ["icons/icon.icns", "icons/icon.png"],
    "macOS": {
      "minimumSystemVersion": "14.0",
      "hardenedRuntime": false
    }
  }
}
